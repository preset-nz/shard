{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shard",
  "version": "0.2.0-alpha",
  "identifier": "nz.preset.shard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shard",
        "width": 1100,
        "height": 780,
        "dragDropEnabled": true,
        "backgroundColor": "#0e0e12",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["shard"],
        "name": "Shard Document",
        "description": "Shard Document",
        "role": "Editor",
        "rank": "Owner",
        "contentTypes": ["nz.preset.shard.document"],
        "exportedType": {
          "identifier": "nz.preset.shard.document",
          "conformsTo": ["public.data", "public.content"]
        }
      }
    ]
  }
}
